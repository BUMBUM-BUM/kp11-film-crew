generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  roles       RolePermission[]
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime @default(now())
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  passwordHash      String
  fullName          String
  groupName         String             @default("КИТ-11")
  roleId            String?
  role              Role?              @relation(fields: [roleId], references: [id])
  course            Int?
  rating            Float?
  telegram          String?
  telegramChatId    String?
  telegramToken     String?
  craftRank         String?            @default("Ассистент цеха")
  isSuspended       Boolean            @default(false)
  skills            String[]
  shoots            Shoot[]            @relation("CreatedShoots")
  crewMembers       CrewMember[]
  pushSubscriptions PushSubscription[]
  createdAt         DateTime           @default(now())
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model Shoot {
  id          String       @id @default(uuid())
  title       String
  description String
  type        String       @default("СТУДИЯ")
  date        DateTime
  callTime    String?      @default("10:00")
  startTime   String?      @default("11:30")
  endTime     String?      @default("18:00")
  timeline    Json?        @default("[]")
  equipment   Json?        @default("[]")
  location    String
  latitude    Float?       @default(55.751244)
  longitude   Float?       @default(37.618423)
  isCompleted Boolean      @default(false)
  creatorId   String
  creator     User         @relation("CreatedShoots", fields: [creatorId], references: [id])
  crew        CrewMember[]
  createdAt   DateTime     @default(now())
}

model CrewMember {
  id            String     @id @default(uuid())
  shootId       String
  shoot         Shoot      @relation(fields: [shootId], references: [id], onDelete: Cascade)
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleInShoot   String
  status        String     @default("PENDING")
  attendance    String     @default("PRESENT")
  invitedAt     DateTime   @default(now())
}

model InventoryItem {
  id           String    @id @default(uuid())
  name         String
  category     String    @default("Камеры")
  serialNumber String?   @default("Б/Н")
  status       String    @default("AVAILABLE")
  location     String?   @default("Склад техники ЦКТ КП11")
  notes        String?   @default("В рабочем состоянии")
  signedBy     String?
  signedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Location {
  id        String   @id @default(uuid())
  name      String
  badge     String?
  type      String   @default("СТУДИЯ")
  latitude  Float?   @default(55.751244)
  longitude Float?   @default(37.618423)
  createdAt DateTime @default(now())
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

