generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Права в системе (например: CREATE_SHOOT, RATE_STUDENTS, MANAGE_ROLES)
model Permission {
  id          String   @id @default(uuid())
  code        String   @unique // Уникальный код права (напр. 'shoot:create')
  name        String   // Человекопонятное название
  roles       RolePermission[]
}

// Динамические роли (Админ, Мастер, Студент и т.д.)
model Role {
  id          String   @id @default(uuid())
  name        String   @unique // Название роли (напр. 'Мастер', 'Студент', 'Ассистент')
  description String?
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime @default(now())
}

// Связь ролей и прав (Многие ко многим)
model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  fullName     String
  
  // Привязка к динамической роли
  roleId       String?
  role         Role?        @relation(fields: [roleId], references: [id])
  
  course       Int?
  specialty    String?      @default("Кино и телепроизводство")
  rating       Float        @default(5.0)
  skills       String[]
  shoots       Shoot[]      @relation("CreatedShoots")
  crewMembers  CrewMember[]
  createdAt    DateTime     @default(now())
}

model Shoot {
  id          String       @id @default(uuid())
  title       String
  description String
  type        String       @default("STUDIO") // STUDIO или LOCATION
  date        DateTime
  location    String
  creatorId   String
  creator     User         @relation("CreatedShoots", fields: [creatorId], references: [id])
  crew        CrewMember[]
  createdAt   DateTime     @default(now())
}

model CrewMember {
  id            String     @id @default(uuid())
  shootId       String
  shoot         Shoot      @relation(fields: [shootId], references: [id], onDelete: Cascade)
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleInShoot   String
  status        String     @default("PENDING") // PENDING, ACCEPTED, DECLINED
  declineReason String?
  invitedAt     DateTime   @default(now())
}
